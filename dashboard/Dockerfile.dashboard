FROM python:3.10-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    streamlit==1.33.0 \
    pandas==2.2.0 \
    pyarrow==15.0.2 \
    pydeck==0.9.0 \
    plotly==5.21.0 \
    watchdog==4.0.0

COPY dashboard.py .

EXPOSE 8501

CMD ["streamlit", "run", "dashboard.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--", "--scored", "/scored"]
